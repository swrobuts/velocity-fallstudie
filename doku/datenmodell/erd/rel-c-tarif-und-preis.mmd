    TARIF_KONDITION {
        bigint    kondition_id PK
        bigint    tarif_id     FK
        daterange gueltigkeit  "EXCLUDE: nie überlappend"
        integer   freiminuten_pro_monat
        numeric   rabatt_prozent
    }
    MITGLIEDSCHAFT {
        bigint    mitgliedschaft_id PK
        bigint    kunde_id          FK
        bigint    tarif_id          FK
        daterange gueltigkeit       "EXCLUDE je Kunde: GR3"
    }
    FREIMINUTEN_PERIODE {
        bigint  periode_id         PK
        bigint  mitgliedschaft_id  FK
        integer jahr               "UK mit monat"
        integer monat
        integer kontingent_minuten "Bestand"
        integer verbraucht_minuten "Bewegung"
    }
    NUTZUNGSPREIS {
        bigint    preis_id          PK
        bigint    typ_id            FK
        daterange gueltigkeit       "EXCLUDE: nie überlappend"
        numeric   startgebuehr
        numeric   preis_pro_minute
        numeric   tageshoechstpreis
    }
    PREISSCHAETZUNG {
        bigint  schaetzung_id     PK
        bigint  start_station_id  "mit ziel_station_id, ohne Fremdschlüssel"
        text    startstation      "UK: Start, Ziel, Typ, Zeitfenster"
        text    typ_code
        text    zeitfenster       "vier Tagesabschnitte"
        integer minuten_von       "mit minuten_bis: Quantile der Dauer"
        numeric preis_von         "mit preis_bis, CHECK: Spanne max. 1,00 EUR"
        integer fahrten_grundlage "CHECK: mindestens 30 Fahrten"
        date    stand
    }
