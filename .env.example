PGHOST=supabase.butscher.cloud
PGPORT=5433
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
SUPABASE_URL=https://supabase.butscher.cloud
SUPABASE_ANON_KEY=

# Anmeldung des Agentenzugangs fuer den MCP-Server. Das Konto wird in
# Supabase Studio angelegt (Authentication -> Add user) und mit
# db/betrieb/mitarbeiter_agentenkonto.sql an velocity.mitarbeiter
# gehaengt. Das Passwort steht NUR hier und nie im Repository - .env ist
# gitignored, diese Beispieldatei zeigt bloss die Felder.
WAWI_AGENT_EMAIL=agent@wawi.invalid
WAWI_AGENT_PASSWORT=
